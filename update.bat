@echo off
chcp 65001 >nul
echo ===================================================
echo     VISTA SPATIAL PROTOCOL — ДЕПЛОЙ НА GITHUB
echo ===================================================
echo.

:: Шаг 1: Принудительно создаем и переключаемся на ветку main
echo [1/4] Настройка корректной ветки (main)...
git branch -M main

:: Шаг 2: Проверяем статус файлов
echo [2/4] Сканирование измененных файлов активов...
git status
echo.

:: Шаг 3: Добавляем все файлы в индекс Git
echo Добавление файлов в коммит...
git add .

:: Шаг 4: Создаем коммит с простым и безопасным текстом без спецсимволов времени
echo Создание слепка системы...
git commit -m "VISTA Core Production Deploy Fix"
echo.

:: Шаг 5: Отправляем файлы строго в ветку main
echo [3/4] Синхронизация с сервером GitHub (ветка main)...
git push -u origin main

if %errorlevel% equ 0 (
    echo.
    echo ===================================================
    echo   [4/4] УСПЕШНО! ВСЕ ФАЙЛЫ ПРОЕКТА НА ГИТХАБЕ!
    echo   Ссылка на сайт: https://github.io
    echo ===================================================
) else (
    echo.
    echo ---------------------------------------------------
    echo   [ОШИБКА] Окно не закроется автоматически.
    echo   Внимательно прочитай текст ошибки выше!
    echo ---------------------------------------------------
)

:: Этот флаг ЗАПРЕТИТ консоли закрываться в любом случае
echo.
echo Нажмите любую клавишу для выхода...
pause >nul
